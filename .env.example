# Copy this file to ".env" and fill in your OWN Firebase project values.
# Get them from: Firebase Console -> Project Settings -> Your apps -> SDK setup and configuration.
#
# IMPORTANT:
# 1. Never commit your real .env file — it is in .gitignore for a reason.
# 2. Only variables prefixed with VITE_ are exposed to the browser by Vite.
# 3. Firebase web API keys are safe to expose in the browser, but you should
#    restrict them in the Google Cloud Console (APIs & Services -> Credentials)
#    to only your website domains and only the APIs your app uses.

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# No other API keys are required: the home / discover / adoptable pets come
# from the local catalog in src/data/db.json, and their photos are bundled
# in public/images/pets/, so they always load with no configuration.
